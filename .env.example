# ===== Supabase =====
# URL del proyecto (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon); siempre limitada por RLS. Segura de exponer en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio (service_role): SOLO servidor. NUNCA usar el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Referencia del proyecto para la CLI (supabase link / gen types)
SUPABASE_PROJECT_REF=znknfjujmhbgwywpuzyq
# Token de acceso personal para la CLI y CI (no versionar; usar secret de GitHub/Vercel)
SUPABASE_ACCESS_TOKEN=

# ===== Aplicación =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
TZ=America/Asuncion

# ===== Integraciones (previstas, vacías por ahora) =====
# Secreto del receptor del reloj biométrico facial ZKTime (api/integraciones/zkteco)
ZKTECO_WEBHOOK_TOKEN=
